# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
# Example: postgresql://securepass:password@localhost:5432/securepass
DATABASE_URL=postgresql://postgres:SecurepassDB@2026@localhost:5432/Securepassword

# Random secret used to sign nothing sensitive by itself, but kept as a pepper
# for session token hashing so a DB leak of token_hash values alone is not
# directly usable. Generate with: openssl rand -base64 48
SESSION_SECRET=SecurePass_Vault_2026_ChangeThisToSomethingRandom_8xK29p

# "production" enables Secure cookies (requires HTTPS) and stricter defaults.
# Use "development" when running locally over plain HTTP.
NODE_ENV=development

# Origin the frontend is served from, used for CORS/cookie SameSite decisions
# if you ever split frontend/backend origins. Same-origin by default in this
# project, so this is mostly informational.
APP_ORIGIN=http://localhost:3000
